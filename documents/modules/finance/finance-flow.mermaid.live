%% Finance module flow, drawn from server/src/finance (checked 2026-10-17).
flowchart TD
    subgraph Clients["Callers"]
        Client["Client (JWT)"]
        Worker["EmailProcessor (email classified as TRANSACTION)"]
        AiEngine["Gemini function calling (AgentService)"]
    end

    subgraph ControllerLayer["FinanceController /api/v1/finance"]
        JwtGuard["JwtAuthGuard"]
        BankCtrl["Accounts<br>- POST, GET /accounts<br>- GET /accounts/total-balance<br>- GET, PATCH, DELETE /accounts/:id<br>- PATCH /accounts/:id/balance"]
        CatCtrl["Categories<br>- POST, GET /categories<br>- PATCH, DELETE /categories/:id"]
        TxCtrl["Transactions<br>- POST /transactions<br>- POST /transactions/search<br>- GET /summary<br>- GET, PATCH, DELETE /transactions/:id"]
    end

    subgraph ServiceLayer["FinanceService"]
        BankService["Accounts: create, list, get, update, delete or deactivate, adjustBalance, getTotalBalance"]
        CatService["Categories: create, list, update (not type), delete"]
        TxService["Transactions: create, search, get, update, delete, summary per currency (balance moves in the same DB transaction)"]
        AiToolReg["AI tools<br>- get_financial_summary<br>- search_financial_transactions<br>- create_financial_transaction (needs confirmation)"]
    end

    subgraph DatabaseLayer["PostgreSQL (Prisma)"]
        BankAccountDB[("bank_accounts: cached_balance")]
        CategoryDB[("categories")]
        TransactionDB[("transactions: unique email_log_id")]
        EmailLogDB[("email_logs")]
    end

    Client -->|JWT| JwtGuard
    JwtGuard --> BankCtrl
    JwtGuard --> CatCtrl
    JwtGuard --> TxCtrl

    BankCtrl --> BankService
    CatCtrl --> CatService
    TxCtrl --> TxService

    Worker -->|createTransaction with emailLogId| TxService
    AiEngine -->|read tools run, create after user confirms| AiToolReg
    AiToolReg --> BankService
    AiToolReg --> TxService

    BankService -->|CRUD| BankAccountDB
    CatService -->|CRUD| CategoryDB
    TxService -->|insert, update or delete| TransactionDB
    TxService -->|increment or decrement, also on update, old and new account| BankAccountDB
    BankService -->|adjustBalance inserts a ledger row| TransactionDB

    TransactionDB -.->|FK account_id, restrict| BankAccountDB
    TransactionDB -.->|FK category_id, set null| CategoryDB
    TransactionDB -.->|FK email_log_id, set null| EmailLogDB
