%% Email module flow, drawn from server/src/email (checked 2026-10-17).
sequenceDiagram
    autonumber
    actor Owner as Owner (JWT)
    participant Google as Google (Pub/Sub push, Gmail API)
    participant Tg as Telegram Bot API
    participant Ctrl as EmailController
    participant Push as GmailPushService
    participant Svc as EmailService / EmailRuleService
    participant Queue as Redis / BullMQ (email-processing)
    participant Worker as EmailProcessor
    participant Ai as EmailAiService (LlmService, no tools)
    participant DB as PostgreSQL

    rect rgb(240, 248, 255)
    note over Owner, DB: 1. Email rules (REST)
    Owner->>Ctrl: POST / GET (optional type filter) / PATCH / DELETE /email-rules
    Ctrl->>Svc: EmailRuleService create / findAll / findOne / update / remove
    Svc->>DB: email_rules (regex checked: max 200 characters, valid syntax)
    Ctrl-->>Owner: { statusCode, message, data }
    end

    rect rgb(255, 245, 238)
    note over Google, DB: 2. Gmail push ingestion
    Google->>Ctrl: POST /email/pubsub (Bearer Google ID token)
    Ctrl->>Push: verifyPushToken (audience, service account)
    alt token missing or wrong
        Push-->>Google: 401
    else Pub/Sub not configured
        Push-->>Google: 503
    end
    Ctrl->>Push: runPass (one at a time, else 503)
    Push->>DB: read users.gmail_history_id
    Push->>Google: Gmail history.list since the stored ID (fallback: INBOX, last day)
    loop each new message
        Push->>Google: messages.get (full)
        Push->>Svc: EmailService.ingest({ messageId, sender, subject, rawBody })
    end
    Push->>DB: save the new gmail_history_id after the whole pass
    Ctrl-->>Google: 200 { fetched }
    end

    rect rgb(255, 250, 205)
    note over Owner, Queue: 3. Ingest (also POST /email/ingest, JWT)
    Svc->>DB: INSERT email_logs (status PENDING)
    alt unique message_id violated
        Svc->>DB: read the existing row
        alt status is not PENDING
            Svc-->>Ctrl: null (duplicate ignored)
        else still PENDING
            note over Svc: continue with the existing row
        end
    end
    Svc->>DB: classify: active email_rules, blacklist > moneylist > whitelist
    alt blacklist
        Svc->>DB: status = SKIPPED (not queued)
    else other
        Svc->>Queue: add process-email-job (jobId = email log ID, priority 1 / 2 / 3, 3 attempts)
    end
    end

    rect rgb(255, 240, 245)
    note over Owner, Queue: 3b. Logs and reprocess (REST, JWT)
    Owner->>Ctrl: GET /email/logs (status, page, pageSize)
    Ctrl->>Svc: EmailService.listLogs
    Svc->>DB: email_logs, newest first, full rows
    Owner->>Ctrl: POST /email/logs/:id/reprocess
    Ctrl->>Svc: EmailService.reprocess
    Svc->>DB: unknown id: 404. Claim FAILED to PENDING, else 400
    Svc->>Queue: remove the old job with the same ID
    Svc->>DB: classify again
    alt blacklist
        Svc->>DB: status = SKIPPED
    else other
        Svc->>Queue: add process-email-job (same options as ingest)
    end
    note over Svc, DB: if removing or queueing fails: status back to FAILED
    end

    rect rgb(245, 255, 250)
    note over Queue, DB: 4. Worker
    Queue->>Worker: process-email-job
    Worker->>DB: status already PROCESSED? then return
    Worker->>Ai: classify(email, ruleType)
    Ai-->>Worker: category, urgent, summary, transaction?, event?
    alt TRANSACTION and exactly one active account matches
        Worker->>DB: FinanceService.createTransaction (unique email_log_id)
    else EVENT
        Worker->>DB: CalendarService.createEvent (sync state DIRTY)
    end
    Worker->>DB: email_logs status = PROCESSED, ai_summary
    opt urgent
        Worker->>Tg: ProactiveService, Telegram text
    end
    note over Worker, DB: after the 3rd failed attempt: status = FAILED
    end
