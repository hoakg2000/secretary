generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ==========================================
// 1. CORE AUTH, CHARACTER & PERSONA SCHEMA
// ==========================================

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String?       @map("password_hash")
  googleAccessToken    String?       @map("google_access_token")
  googleRefreshToken   String?       @map("google_refresh_token")
  googleTokenExpiresAt DateTime?     @map("google_token_expires_at")
  gmailHistoryId       String?       @map("gmail_history_id") // mốc Gmail history đã nạp xong (Pub/Sub push)
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  userSessions         UserSession[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  // Kept by decision D14 for future multi-user / multi-device support. Never written today.
  deviceId    String?   @map("device_id")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("user_sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  sessionId String   @map("session_id")
  tokenHash String   @unique @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Character {
  id        String    @id @default(uuid())
  name      String
  voiceId   String?   @map("voice_id")
  source    String?
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  personas  Persona[]

  @@map("characters")
}

enum PersonaType {
  SYSTEM_PROMPT
  TONE
  IDENTITY
  KNOWLEDGE_BACKGROUND
  RELATIONSHIP_DYNAMICS
  OTHER
}

model Persona {
  id          String      @id @default(uuid())
  characterId String      @map("character_id")
  type        PersonaType
  value       String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("personas")
}

// ==========================================
// 2. EMAIL & PROCESSING QUEUE SCHEMA
// ==========================================

enum EmailStatus {
  PENDING
  PROCESSED
  SKIPPED
  FAILED
}

model EmailLog {
  id           String        @id @default(uuid())
  messageId    String        @unique @map("message_id")
  sender       String
  subject      String?
  rawBody      String?       @map("raw_body") @db.Text
  status       EmailStatus   @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")

  transactions Transaction[]

  @@index([status])
  @@map("email_logs")
}

enum EmailRuleType {
  blacklist
  moneylist
  whitelist
}

enum EmailMatcher {
  sender
  keyword
  regex
}

model EmailRule {
  id          String        @id @default(uuid())
  type        EmailRuleType
  matcher     EmailMatcher
  matchValue  String        @map("match_value")
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("email_rules")
}

// Kept by decision D11. Unused: BullMQ keeps job state in Redis.
model QueueJob {
  id           String   @id @default(uuid())
  jobId        String   @unique @map("job_id")
  queueName    String   @map("queue_name")
  payload      Json
  retryCount   Int      @default(0) @map("retry_count")
  errorLog     String?  @map("error_log") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("queue_jobs")
}

// ==========================================
// 3. FINANCE & LOCAL CALENDAR PROXY SCHEMA
// ==========================================

model BankAccount {
  id            String        @id @default(uuid())
  accountName   String        @map("account_name")
  bankCode      String        @map("bank_code")
  accountNumber String        @map("account_number")
  cachedBalance Decimal       @default(0) @map("cached_balance") @db.Decimal(18, 2)
  currency      String        @default("VND")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  transactions  Transaction[]

  @@map("bank_accounts")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id              String          @id @default(uuid())
  accountId       String          @map("account_id")
  categoryId      String?         @map("category_id")
  amount          Decimal         @db.Decimal(18, 2)
  type            TransactionType
  counterparty    String?
  note            String?         @db.Text
  transactionTime DateTime        @map("transaction_time")
  emailLogId      String?         @unique @map("email_log_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  account         BankAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  emailLog        EmailLog?       @relation(fields: [emailLogId], references: [id], onDelete: SetNull)

  @@index([accountId, transactionTime])
  @@index([categoryId])
  @@map("transactions")
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         TransactionType
  icon         String?
  budgetLimit  Decimal?      @map("budget_limit") @db.Decimal(18, 2)
  createdAt    DateTime      @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("categories")
}

model LocalCalendar {
  id             String             @id @default(uuid())
  title          String
  description    String?            @db.Text
  location       String?
  startTime      DateTime           @map("start_time")
  endTime        DateTime           @map("end_time")
  attendees      Json?
  intent         String?
  priorityStatus String?            @map("priority_status")
  deletedAt      DateTime?          @map("deleted_at")  // xóa mềm: chờ job sync xóa trên Google rồi mới xóa hẳn
  remindedAt     DateTime?          @map("reminded_at") // đã gửi nhắc lịch cho startTime hiện tại
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  syncState      CalendarSyncState?

  @@index([startTime])
  @@map("local_calendars")
}

enum SyncStatus {
  SYNCED
  DIRTY
  CONFLICT
}

model CalendarSyncState {
  id            String        @id @default(uuid())
  localEventId  String        @unique @map("local_event_id")
  googleEventId String?       @map("google_event_id")
  syncStatus    SyncStatus    @default(DIRTY) @map("sync_status")
  lastSyncedAt  DateTime?     @map("last_synced_at")
  eTag          String?       @map("etag")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  localEvent    LocalCalendar @relation(fields: [localEventId], references: [id], onDelete: Cascade)

  @@index([syncStatus])
  @@map("calendar_sync_states")
}

// ==========================================
// 4. AI SEMANTIC MEMORY & PGVECTOR SCHEMA
// ==========================================

model AiMemory {
  id             String           @id @default(uuid())
  content        String           @db.Text
  embedding      Unsupported("vector(1536)")?
  contentTsv     Unsupported("tsvector")?     @map("content_tsv")
  category       String?
  source         String?                      // CHAT / EMAIL / MANUAL
  initialScore   Float            @default(1.0) @map("initial_score")
  decayFactor    Float            @default(0.01) @map("decay_factor")
  lastAccessedAt DateTime         @default(now()) @map("last_accessed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("ai_memories")
}

// Kept by decision D7. Not called from anywhere and nothing reads rag_chunks yet (see RagChunkService).
model RagChunk {
  id        String   @id @default(uuid())
  sourceId  String?  @map("source_id")
  chunkText String   @map("chunk_text") @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("rag_chunks")
}