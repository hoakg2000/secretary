# Copy to .env and fill in. Validated at startup by src/config/env.validation.ts.

# ---- Required ----
# Postgres connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://secretary_user:secretary_password@localhost:5432/secretary_db
# Signs access tokens and OAuth state. At least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-32+-chars
# Signs refresh tokens. At least 32 characters, different from JWT_SECRET.
JWT_REFRESH_SECRET=change-me-to-another-random-string-32+
# Redis for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Optional with defaults ----
# HTTP port
PORT=3000
# "production" turns on the Secure flag of the refresh cookie
NODE_ENV=development
# Access token lifetime
JWT_EXPIRES_IN=15m
# Refresh token lifetime (also the cookie and DB expiry)
JWT_REFRESH_EXPIRES_IN=7d
# Allowed CORS origin
CLIENT_URL=http://localhost:3000

# ---- Optional, feature-gated ----
# Google OAuth2 (Calendar sync, Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# 32 random bytes, base64. Required when GOOGLE_CLIENT_ID is set. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Gemini chat and embeddings
GEMINI_API_KEY=
# Embedding model; must support outputDimensionality 1536
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Fish.audio text-to-speech
FISH_AUDIO_API_KEY=
FISH_AUDIO_DEFAULT_VOICE_ID=
# Email worker concurrency
BULLMQ_CONCURRENCY=3
# Calendar push-sync schedule (cron expression)
CALENDAR_SYNC_CRON=0 */5 * * * *
# Timezone used in reminder text and the chat system prompt
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Telegram text delivery of proactive notifications (both needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Seed only (npm run seed) ----
MASTER_EMAIL=
MASTER_PASSWORD=
