# Copy to .env and fill in. Validated at startup by src/config/env.validation.ts.

# ---- Required ----
# Postgres connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://secretary_user:secretary_password@localhost:5432/secretary_db
# Signs access tokens and OAuth state. At least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-32+-chars
# Signs refresh tokens. At least 32 characters, different from JWT_SECRET.
JWT_REFRESH_SECRET=change-me-to-another-random-string-32+
# Redis for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Optional with defaults ----
# HTTP port
PORT=3000
# "production" turns on the Secure flag of the refresh cookie
NODE_ENV=development
# Access token lifetime
JWT_EXPIRES_IN=15m
# Refresh token lifetime (also the cookie and DB expiry)
JWT_REFRESH_EXPIRES_IN=7d
# Allowed CORS origin
CLIENT_URL=http://localhost:3001

# ---- Optional, feature-gated ----
# Google OAuth2 (Calendar sync, Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# 32 random bytes, base64. Required when GOOGLE_CLIENT_ID is set. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Gemini chat and embeddings
GEMINI_API_KEY=
# Embedding model; must support outputDimensionality 1536
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MộtAPI key, used when LLM_TYPE is 'motapi' (src/llm/llm.service.ts)
# MOT_API_KEY=
# Fish.audio text-to-speech
FISH_AUDIO_API_KEY=
# Email worker concurrency
BULLMQ_CONCURRENCY=3
# Redis key prefix for BullMQ queues (default "bull"); set to isolate workers between environments
# BULLMQ_PREFIX=
# Calendar push-sync schedule (cron expression)
CALENDAR_SYNC_CRON=0 */5 * * * *
# Timezone used in reminder text, the chat system prompt and email classification
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Telegram text delivery of proactive notifications (both needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only behind a reverse proxy or tunnel: number of proxies in front (e.g. 1), or trusted IPs/subnets (e.g. loopback)
TRUST_PROXY=
# Gmail Pub/Sub push ingestion (all three needed; see documents/setup.md)
# projects/<project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
# Audience and service account email of the push subscription
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# ---- Integration tests only (npm run test:int) ----
# Database name must end with _test: the suite truncates every table. Default shown.
# TEST_DATABASE_URL=postgresql://secretary_user:secretary_password@localhost:5432/secretary_test

# ---- Seed only (npm run seed) ----
MASTER_EMAIL=
MASTER_PASSWORD=
